<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="top.egon.enjoyshop.goods.infrastructure.goods.dao.BrandDAO">
    <resultMap id="BrandPOResultMap" type="top.egon.enjoyshop.goods.infrastructure.goods.po.BrandPO">
        <id column="id" property="id"/>
        <result column="name" property="name"/>
        <result column="image" property="image"/>
        <result column="letter" property="letter"/>
        <result column="seq" property="seq"/>
        <result column="tenant_id" property="tenantId"/>
        <result column="create_user_id" property="createUserId"/>
        <result column="create_time" property="createTime"/>
        <result column="update_user_id" property="updateUserId"/>
        <result column="update_time" property="updateTime"/>
        <result column="deleted_at" property="deletedAt"/>
        <result column="version" property="version"/>
    </resultMap>
    <sql id="columns">id, tenant_id, create_user_id, create_time, update_user_id, update_time, deleted_at, version, name, image, letter, seq</sql>
    <select id="selectActiveById" resultMap="BrandPOResultMap">
        SELECT <include refid="columns"/> FROM brand WHERE id = #{id} AND deleted_at IS NULL
    </select>
    <select id="selectActiveByIds" resultMap="BrandPOResultMap">
        SELECT <include refid="columns"/> FROM brand WHERE deleted_at IS NULL
        <choose>
            <when test="ids != null and ids.size() &gt; 0">
                AND id IN
                <foreach collection="ids" item="id" open="(" separator="," close=")">#{id}</foreach>
            </when>
            <otherwise>AND 1 = 0</otherwise>
        </choose>
    </select>
    <update id="deleteVersionedById">
        UPDATE brand
        SET deleted_at = (CURRENT_TIMESTAMP AT TIME ZONE 'UTC'),
            update_user_id = #{et.updateUserId},
            update_time = #{et.updateTime},
            version = version + 1
        WHERE id = #{et.id} AND deleted_at IS NULL AND version = #{MP_OPTLOCK_VERSION_ORIGINAL}
    </update>
    <select id="selectByQuery" resultMap="BrandPOResultMap">
        SELECT <include refid="columns"/> FROM brand
        WHERE deleted_at IS NULL
        <if test="query.name != null">AND name = #{query.name}</if>
        <if test="query.letter != null">AND letter = #{query.letter}</if>
        ORDER BY id ASC
        LIMIT #{limit} OFFSET #{offset}
    </select>
</mapper>
